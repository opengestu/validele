# Backend (Node/Express on Render)
# Copy this file to backend/.env locally or define vars in Render dashboard.
# Do not commit real secrets.

# Runtime
NODE_ENV=production
PORT=5000
INTERNAL_BASE_URL=http://localhost:5000

# CORS allow-list origin (set to your Cloudflare Pages URL in production)
VITE_DEV_ORIGIN=https://your-project.pages.dev
# Additional allowed frontend origins (comma-separated, no spaces)
# Example: https://your-project.pages.dev,https://validele.numacademy110.workers.dev
CORS_ALLOWED_ORIGINS=

# Supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_ANON_KEY=<your-supabase-anon-key>
# Legacy fallback names used by parts of the codebase
# SUPABASE_KEY=<your-supabase-anon-key>
# SUPABASE_CLIENT_KEY=<your-supabase-anon-key>
# VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
# VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Auth
JWT_SECRET=<long-random-secret>
ADMIN_JWT_SECRET=<another-long-random-secret>
ADMIN_USER_ID=<admin-profile-uuid>
ADMIN_TOKEN_TTL=3600

# Direct7 SMS
DIRECT7_API_KEY=<direct7-api-key>
D7_API_KEY_NOTIFY=<direct7-notify-api-key>
D7_SMS_URL=https://api.d7networks.com/messages/v1/send

# Direct7 OTP provider validation (real OTP verify by D7)
D7_OTP_PROVIDER_ENABLED=true
D7_OTP_PROVIDER_STRICT=false
D7_OTP_SEND_URL=https://api.d7networks.com/verify/v1/otp/send-otp
D7_OTP_VERIFY_URL=https://api.d7networks.com/verify/v1/otp/verify-otp
D7_OTP_ORIGINATOR=VALIDEL
D7_OTP_TEMPLATE=Votre code de verification VALIDEL est: {}. Il expire dans 5 minutes.
D7_OTP_LENGTH=4
D7_OTP_EXPIRY_SECONDS=300
D7_OTP_RESEND_COOLDOWN_MS=60000

# Firebase push
FIREBASE_PROJECT_ID=validel-d7c83
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# PayDunya
PAYDUNYA_MODE=prod
PAYDUNYA_MASTER_KEY=<paydunya-master-key>
PAYDUNYA_PRIVATE_KEY=<paydunya-private-key>
PAYDUNYA_PUBLIC_KEY=<paydunya-public-key>
PAYDUNYA_TOKEN=<paydunya-token>
PAYDUNYA_CANCEL_URL=https://your-frontend.domain/payment/cancel
PAYDUNYA_RETURN_URL=https://your-frontend.domain/payment/success
PAYDUNYA_CALLBACK_URL=https://your-backend.onrender.com/api/paydunya/callback

# PixPay / Orange / Wave
PIXPAY_API_KEY=<pixpay-api-key>
PIXPAY_BUSINESS_ID=<pixpay-business-id>
PIXPAY_SERVICE_ID_CLIENT_PAYMENT=213
PIXPAY_SERVICE_ID_VENDOR_PAYOUT=214
PIXPAY_BASE_URL=https://proxy-coreapi.pixelinnov.net/api_v1
PIXPAY_IPN_BASE_URL=https://your-backend.onrender.com
PIXPAY_WAVE_SERVICE_ID=79
PIXPAY_WAVE_BUSINESS_NAME_ID=<pixpay-wave-business-name-id>
PIXPAY_WAVE_REDIRECT_URL=https://your-frontend.domain/payment-success
PIXPAY_WAVE_REDIRECT_ERROR_URL=https://your-frontend.domain/payment-error
# Délai maximal global du fallback de paiement PayDunya (ms). Évite que la requête
# traîne (~60s : 2 appels de 30s) et se termine en "Failed to fetch" côté navigateur.
# Au-delà, l'endpoint renvoie une erreur propre et rapide. Défaut 18000 (18s).
PAYMENT_FALLBACK_TIMEOUT_MS=18000

# Update checker endpoint
# Must match the version published on Play Store (versionName in android/app/build.gradle).
APP_LATEST_VERSION=3.6.9
# Optional aliases accepted by code:
# LATEST_APP_VERSION=1.0.0
# ANDROID_LATEST_VERSION=1.0.0
FORCE_APP_UPDATE=false
APP_UPDATE_MESSAGE=Une nouvelle version est disponible. Veuillez mettre à jour l'application.

# Schedulers and reconcilers
ENABLE_PAYOUT_SCHEDULER=false
PAYOUT_SCHEDULE_CRON=0 2 * * *
ENABLE_PAYMENT_RECONCILER=false
PAYMENT_RECONCILE_CRON=*/5 * * * *
PAYMENT_RECONCILE_MINUTES=15
# ATTENTION : PAYMENT_RECONCILE_FORCE confirme des transactions SANS vérification fournisseur.
# Il ne s'applique jamais aux sorties d'argent (payouts, retraits admin, remboursements).
PAYMENT_RECONCILE_FORCE=false

# --- Veilleur des transferts admin ---
# Un transfert sans IPN Pixpay au bout de TRANSFER_STALE_MINUTES passe en statut UNKNOWN
# ("À vérifier") au lieu de rester affiché comme en cours / réussi.
TRANSFER_STALE_MINUTES=30
TRANSFER_WATCHDOG_CRON=*/10 * * * *
DISABLE_TRANSFER_WATCHDOG=false

# PIN protection tuning
PIN_MAX_ATTEMPTS=5
PIN_ATTEMPT_WINDOW_MS=300000
PIN_LOCK_MS=900000

# OTP protection tuning
OTP_SEND_MAX_ATTEMPTS=3
OTP_SEND_WINDOW_MS=600000
OTP_VERIFY_MAX_ATTEMPTS=5
OTP_VERIFY_WINDOW_MS=600000
OTP_LOCK_MS=900000

# Debug flags
DEBUG=false
DEBUG_PIXPAY=false

# Optional test-only variables
TEST_FCM_TOKEN=
ADMIN_URL=http://localhost:5000
API_URL=http://localhost:3000
ADMIN_TOKEN=
ADMIN_PROFILE_ID=
ADMIN_PIN=
ORDER_ID=

PUBLIC_WEB_URL=https://www.validel.shop
PIXPAY_PUBLIC_WEB_URL=https://www.validel.shop
FRONTEND_URL=https://www.validel.shop

# --- Bot WhatsApp conversationnel (D7) ---
# Token secret imprévisible placé dans l'URL du webhook (D7 ne signe pas ses webhooks).
# Le webhook devient : POST /api/whatsapp/webhook/<WHATSAPP_WEBHOOK_SECRET>
WHATSAPP_WEBHOOK_SECRET=
# Numéro WhatsApp Business Validèl enregistré sur D7 (international sans +, ex. 221771234567).
# NB : distinct de D7_OTP_ORIGINATOR (sender ID SMS alphanumérique 'VALIDEL').
# Sert aussi de numéro de REPLI quand le webhook entrant ne porte pas de `recipient`.
WHATSAPP_BOT_NUMBER=
# --- Test mode / démonstration (voir backend/demo.js + RUNBOOK-DEMO-BOT.md) ---
# Numéros de bot traités comme DÉMO (séparés par des virgules, chiffres sans +).
# Une commande née de ces numéros est marquée is_demo et ne peut JAMAIS déclencher
# de virement vendeur. Laisser vide (variable définie mais vide) désactive la démo.
# Défaut si non défini : 15554677146
WHATSAPP_DEMO_BOT_NUMBERS=
# Code du produit de démonstration (défaut PD0000 — hors de la plage PD1000-9999
# générée par l'app, donc aucune collision possible avec un vrai produit).
DEMO_PRODUCT_CODE=
# Le produit de demonstration est-il accessible depuis le numero de PROD ?
# true (defaut) : un testeur deroule le parcours complet depuis le bot principal.
#   La fiche annonce la demonstration des sa premiere ligne, la commande creee
#   est marquee is_demo (donc hors payouts et hors chiffres reels), et AUCUN lien
#   de paiement reel n est emis : le parcours s arrete avant initiatePayment.
# false : ancien comportement, catalogue demo reserve aux numeros de bot demo.
WHATSAPP_DEMO_PRODUCT_PUBLIC=
# Vendeur de démonstration créé par backend/scripts/seed-demo-catalog.js.
# Sans DEMO_VENDOR_PASSWORD, le script génère un mot de passe et l'affiche UNE fois.
DEMO_VENDOR_EMAIL=
DEMO_VENDOR_PASSWORD=
DEMO_PRODUCT_PRICE=
# Frais de protection ACHETEUR (en %, ex. 3) — SANS RAPPORT avec la commission
# vendeur (réglée séparément par un admin au moment du payout). Réglable à tout
# moment : source de vérité UNIQUE pour le bot WhatsApp ET le montant réellement
# facturé sur la page de paiement invité (lu en temps réel, pas de rebuild requis).
# Défaut 0 si non défini (pas de frais surprise).
VALIDEL_COMMISSION_PCT=0
# Base publique pour construire le lien produit /product/{code} envoyé par le bot.
PUBLIC_WEB_BASE_URL=https://www.validel.shop
# Optionnel : endpoint d'envoi WhatsApp interactif D7 (défaut: https://api.d7networks.com/whatsapp/v2/send)
D7_WHATSAPP_URL=
# Mode test : true = le bot n'appelle PAS D7, il affiche dans les logs ce qu'il aurait envoyé.
# Idéal pour tester le parcours en local sans numéro WhatsApp ni compte D7.
WHATSAPP_BOT_DRY_RUN=false
# Clé API Anthropic : permet au bot de répondre par IA (Claude Haiku) à toute
# question libre sur le produit consulté (au lieu de la seule FAQ à 3 sujets fixes).
# Sans elle, le bot revient au comportement précédent (invite à envoyer un code).
ANTHROPIC_API_KEY=
# Garde-fou anti-abus : nombre max de questions IA répondues par numéro / 24h.
WHATSAPP_AI_QA_MAX_PER_DAY=8

# --- Checkout conversationnel (nom + adresse + wallet collectés dans le chat) ---
# true (défaut) : le bouton « Payer en sécurité » lance le parcours dans WhatsApp.
# false : rétablit l'ancien comportement (lien vers le formulaire web /product/{code}).
WHATSAPP_CHAT_CHECKOUT=true
# Base utilisée par le bot pour appeler ses propres routes (même process Express).
# À renseigner seulement si le service n'écoute pas sur 127.0.0.1:$PORT.
WHATSAPP_INTERNAL_BASE_URL=
# Quartiers proposés dans la liste de livraison (9 maximum : WhatsApp plafonne une
# liste à 10 lignes, la 10e étant « Autre quartier »). Laisser vide = valeurs par défaut.
WHATSAPP_DELIVERY_ZONES=
# Bannière (logos Wave + Orange Money) affichée en en-tête du choix du paiement.
# Un bouton WhatsApp ne peut pas porter d'image : c'est le seul visuel possible.
# Vide = aucun en-tête. Image générée par `node scripts/generate-wallet-banner.mjs`.
WHATSAPP_WALLET_BANNER_URL=https://www.validel.shop/images/wallets-wave-orange.png
# Fallback SMS anti-doublon pour la notif "en cours de livraison" : WhatsApp
# d'abord, SMS UNIQUEMENT si non lu après 10 min (jamais les 2 en même temps).
# true par défaut ; passer à false pour désactiver le reconciler périodique.
ENABLE_WHATSAPP_READ_FALLBACK=true
# Template Meta approuvé pour la notif "en cours de livraison" (livrée même hors
# fenêtre 24h). Nom EXACT du template + code langue EXACT tels qu'approuvés.
# Structure attendue : corps avec 1 variable {{1}} = nom du produit.
# Si vide -> repli sur message libre (ne part que dans la fenêtre 24h).
WHATSAPP_TEMPLATE_DELIVERY_NAME=
WHATSAPP_TEMPLATE_DELIVERY_LANG=fr
# Le bouton URL du template est-il DYNAMIQUE (URL de base + suffixe {{1}} = orderId) ?
# false (défaut) = bouton URL statique : on n'envoie aucun paramètre de bouton.
# Envoyer un paramètre à un bouton statique => Meta rejette le message
# (#132018 "button at index 0 of type url does not require parameters"), facturé
# et jamais remis. Ne passer à true qu'après avoir rendu l'URL dynamique côté Meta.
WHATSAPP_TEMPLATE_DELIVERY_URL_DYNAMIC=false
# =============================================================================
# Bot WhatsApp DEMO sur Meta Cloud API (backend/meta-whatsapp.js)
# =============================================================================
# Transporteur SEPARE de Direct7. La prod (WHATSAPP_BOT_NUMBER) reste sur D7 et
# n est pas impactee. Le bot demo ne se monte QUE si les 3 variables suivantes
# sont renseignees -> absent par defaut en dev et en CI.
#
# ALIAS ACCEPTES (pour ne pas renommer ce qui est deja pose sur Render) :
#   META_ACCESS_TOKEN        <- WHATSAPP_ACCESS_TOKEN
#   META_PHONE_NUMBER_ID     <- WHATSAPP_PHONE_NUMBER_ID
#   META_APP_SECRET          <- WHATSAPP_APP_SECRET
#   META_WEBHOOK_VERIFY_TOKEN<- WEBHOOK_VERIFY_TOKEN
#   META_BOT_NUMBER          <- WHATSAPP_DEMO_NUMBER
# META_* gagne si les deux sont definies. META_WEBHOOK_SECRET n a PAS d alias :
# il doit rester distinct de WHATSAPP_WEBHOOK_SECRET (secret du webhook D7).
# WHATSAPP_BUSINESS_ACCOUNT_ID n est PAS utilise par le code (gestion des
# templates uniquement) : le poser ne fait ni bien ni mal.
#
# Numero business Meta, international SANS + (ex. 221756509302).
# Pense a l ajouter aussi a WHATSAPP_DEMO_BOT_NUMBERS ci-dessus, sinon le
# catalogue demo restera invisible et les commandes ne seront pas marquees is_demo.
META_BOT_NUMBER=
# Identifiant du numero chez Meta (WhatsApp Manager -> API Setup).
META_PHONE_NUMBER_ID=
# Token System User permanent (permissions whatsapp_business_messaging
# + whatsapp_business_management). Ne s affiche qu une fois a la generation.
META_ACCESS_TOKEN=
# App secret Meta : sert a verifier la signature X-Hub-Signature-256 des webhooks.
# SANS LUI, TOUS LES POST ENTRANTS SONT REJETES (401).
META_APP_SECRET=
# Token de verification choisi par toi, recopie a l identique dans la console Meta
# lors de l abonnement au webhook (challenge GET).
META_WEBHOOK_VERIFY_TOKEN=
# Secret place dans l URL du webhook, comme cote D7 (defense en profondeur) :
#   https://<backend>/api/whatsapp/webhook/meta/<META_WEBHOOK_SECRET>
META_WEBHOOK_SECRET=
# Version de l API Graph (defaut v21.0).
META_GRAPH_VERSION=
# true = logue les envois au lieu de les emettre (equivalent WHATSAPP_BOT_DRY_RUN).
META_DRY_RUN=
